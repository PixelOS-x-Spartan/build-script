{
  "name": "AxionOS",
  "manifest": {
    "url": "https://github.com/AxionAOSP/android.git",
    "branch": "lineage-23.1"
  },
  "sync_jobs": 24,
  "build": {
    "envsetup": "build/envsetup.sh",
    "lunch": "axion spartan user gms core",
    "command": "ax -br",
    "clean_command": "make clean",
    "installclean_command": "make installclean"
  },
  "output": {
    "pattern": "*axion*.zip"
  }
}
